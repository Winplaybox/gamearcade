{
  "expo": {
    "name": "Game Arcade",
    "slug": "game-arcade",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1D1011",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D1011"
    },
    "android": {
      "package": "com.winplaybox.gamearcade",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D1011"
      }
    },
    "plugins": [
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2699537002342677~7598338278",
          "iosAppId": "ca-app-pub-2699537002342677~7598338278",
          "delayAppMeasurementInit": true
        }
      ]
    ]
  }
}