{
  "expo": {
    "name": "Game Arcade",
    "slug": "game-arcade",
    "scheme": "gamearcade",
    "version": "1.0.19",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1D1011",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D1011",
      "imageWidth": 642
    },
    "android": {
      "package": "com.winplaybox.gamearcade",
      "versionCode": 20,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D1011"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "gamearcade"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "play.winplaybox.in",
              "pathPrefix": "/game"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2699537002342677~7598338278",
          "iosAppId": "ca-app-pub-2699537002342677~7598338278",
          "delayAppMeasurementInit": true
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "gradleJvmArgs": "-Xmx3072m -XX:MaxMetaspaceSize=512m"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c825b1fc-b90b-46bc-8020-125ba3af233e"
      }
    },
    "owner": "winplaybox"
  }
}
